import sys
import speech_recognition as sr
import subprocess
import tempfile
from pathlib import Path

temp_wav = None

# Create a recognizer instance
recognizer = sr.Recognizer()

if len(sys.argv) < 2:
    print("Usage: python script_name.py <audio_file>")
    sys.exit(1)

audio_file = sys.argv[1]

if not Path(audio_file).is_file():
    print(f"Error: audio file not found: {audio_file}")
    sys.exit(1)

languages = {
        "1": ("English", "en-US"),
        "2": ("Hindi", "hi-IN"),
        "3": ("Urdu", "ur-PK"),
        "4": ("Portuguese", "pt-BR"),
        "5": ("Spanish", "es-ES"),
        "6": ("Arabic", "ar-SA"),
        "7": ("French", "fr-FR"),
        "8": ("German", "de-DE"),
        }

target_languages = {
        "1": ("English", "en"),
        "2": ("Hindi", "hi"),
        "3": ("Urdu", "ur"),
        "4": ("Portuguese", "pt"),
        "5": ("Spanish", "es"),
        "6": ("Arabic", "ar"),
        "7": ("French", "fr"),
        "8": ("German", "de"),
        }
print("Audio :")

for number, (name, code) in languages.items():
    print(f"{number}. {name}")

choice = input("Enter your choice: ")

if choice not in languages:
    print("Error: Invalid language choice.")
    sys.exit(1)


language_name, source_language = languages[choice]
source_translation_language = source_language.split("-")[0]

#print(f"Selected language: {language_name}")
print(" ")

print("Translate :")

for number, (name, code) in target_languages.items():
    print(f"{number}. {name}")

target_choice = input("Enter your choice: ")

if target_choice not in target_languages:
    print("Error: Invalid target language choice.")
    sys.exit(1)

target_language_name, target_language = target_languages[target_choice]
print(" ")
print(f"Target language: {target_language_name}")

print(f"Selected language: {language_name}")



# Get the audio file path from command line arguments
if len(sys.argv) < 2:
    print("Usage: python script_name.py <audio_file>")
    sys.exit(1)

audio_file = sys.argv[1]

if not Path(audio_file).is_file():
    print(f"Error: audio file not found: {audio_file}")
    sys.exit(1)




# Convert audio file using ffmpeg
try:
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as temp:
        temp_wav = temp.name

    subprocess.run(
            ["ffmpeg", "-i", audio_file, "-ar", "16000", "-ac", "1", temp_wav, "-y"],
            check=True
            )

    audio_file = temp_wav

except FileNotFoundError:
    print("Error: FFmpeg is not installed or cannot be found.")
    sys.exit(1)

except subprocess.CalledProcessError as e:
    print("Error occurred while converting audio:", e)
    sys.exit(1)






# Process audio and always clean up temporary file
try:
    # Load audio data
    with sr.AudioFile(audio_file) as source:
        audio_data = recognizer.record(source)

    # Recognize speech using Google Web Speech API
    try:
        # Specify language as English (United States) and Portuguese (Brazil)
        text_source = recognizer.recognize_google(audio_data, language=source_language)
        print(" ")
        print(f"{language_name} :", text_source)

        result = subprocess.run(
                ["trans", "-b", "-s", source_translation_language, "-t", target_language, text_source],
                capture_output=True,
                text=True,
                check=True
                )

        print(" ")
        print(f"{target_language_name} :", result.stdout)

    except sr.UnknownValueError:
        print("Google Web Speech API could not understand audio")

    except FileNotFoundError:
        print("Error: Translate Shell (trans) is not installed or cannot be found.")

    except subprocess.CalledProcessError as e:
        print("Error: Translation failed.")
        print(e)

    except sr.RequestError as e:
        print("Could not request out from Google Web Speech API; {0}".format(e))



finally:
    if temp_wav:
        Path(temp_wav).unlink(missing_ok=True)

